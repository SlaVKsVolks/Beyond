# Generated files that tests compare byte for byte with what they generate: LF on every OS, also
# where Git for Windows' core.autocrlf would check them out with CRLF.
docs/launcher-commands.md text eol=lf
docs/horizon-ctl-commands.md text eol=lf
website/src/tokens.css text eol=lf
docs/api/*-reference.md text eol=lf
# First-party Rust formatter inputs use canonical LF on every host.
/crates/**/*.rs text eol=lf
/crates/cargo-horizon-mod/template/**/*.rs !text !eol
/crates/horizon-prepare/tests/support/java_probe.rs !text !eol
/launcher/**/*.rs text eol=lf
/launcher/tests/support/console_probe.rs !text !eol
/mods/official/**/*.rs text eol=lf
/xtask/**/*.rs text eol=lf
# The registered mod-alloc fork hashes ORIGINAL LF bytes, including inactive
# unsafe sources. Never let Windows autocrlf change this reviewed boundary.
/third_party/mod-alloc/** text eol=lf
# Preserve the second explicitly registered published-source boundary byte-exact.
/third_party/thread-priority/** text eol=lf
